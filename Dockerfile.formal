FROM mcr.microsoft.com/azurelinux/base/python:3.12@sha256:379135d4dbe66b12825a54d4ed7aef21aa61227533ff1b9151d70f95f9266746

ARG PIP_INDEX_URL=https://pypi.org/simple

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    BRACE_FORMAL_RELEASE=1 \
    BRACE_IMAGE_CLASS=FORMAL_UPLOAD \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10 \
    OMP_NUM_THREADS=4 \
    OPENBLAS_NUM_THREADS=4 \
    MKL_NUM_THREADS=4 \
    CONTEST_SUBMISSION=contest_submission

WORKDIR /app
RUN tdnf install -y shadow-utils \
    && tdnf clean all
COPY requirements.formal.lock /app/requirements.formal.lock
RUN python3 -m pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" --only-binary=:all: -r /app/requirements.formal.lock \
    && rm /app/requirements.formal.lock \
    && find /usr/lib/python3.12/site-packages -type d -name __pycache__ -prune -exec rm -rf '{}' +

COPY src/contest_harness /app/src/contest_harness
COPY src/brace_formal /app/src/brace_formal
COPY submission/harness.py /app/harness.py
COPY submission/contest_submission.py /app/contest_submission.py

RUN useradd --create-home --uid 10001 brace \
    && chown -R root:root /app \
    && chmod -R a-w /app
USER 10001:10001

ENTRYPOINT ["python3", "/app/harness.py"]
CMD ["--help"]
